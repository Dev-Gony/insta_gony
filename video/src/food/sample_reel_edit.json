  "lines": [
    {
      "from": 0.0,
      "duration": 2.82,
      "text": "**갓 삶은** 첫 족발이에요",
      "voice": "videos/224485765186/voice/01.wav"
    },
    {
      "from": 2.82,
      "duration": 4.94,
      "text": "명동 **미쓰족발**, 오전 11시에 문 열어요",
      "voice": "videos/224485765186/voice/02.wav"
    },
    {
      "from": 7.76,
      "duration": 2.74,
      "text": "문 열자마자 들어갔어요",
      "voice": "videos/224485765186/voice/03.wav"
    },
    {
      "from": 10.5,
      "duration": 3.26,
      "text": "황제족발, **58,000원**",
      "voice": "videos/224485765186/voice/04.wav"
    },
    {
      "from": 13.76,
      "duration": 3.34,
      "text": "**갓 삶아서** 따끈하고 촉촉해요",
      "voice": "videos/224485765186/voice/05.wav"
    },
    {
      "from": 17.1,
      "duration": 5.06,
      "text": "쌈채소, 김치, 두부까지\n**한 상 가득**",
      "voice": "videos/224485765186/voice/06.wav"
    },
    {
      "from": 22.16,
      "duration": 4.06,
      "text": "족발 시키면 김치칼국수가 **무료**예요",
      "voice": "videos/224485765186/voice/07.wav"
    },
    {
      "from": 26.22,
      "duration": 4.18,
      "text": "새우젓 장 한 번, **양념장** 한 번",
      "voice": "videos/224485765186/voice/08.wav"
    },
    {
      "from": 30.4,
      "duration": 4.54,
      "text": "껍질은 **쫀득**하고, 살은 부드러워요",
      "voice": "videos/224485765186/voice/09.wav"
    },
    {
      "from": 34.94,
      "duration": 2.94,
      "text": "쌈으로도 **한 입**",
